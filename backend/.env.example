# =============================================================================
# IPO & Micro-Cap AI Scouter — Environment Configuration
# =============================================================================

# Gemini API (Multi-Agent Analysis: Bull, Bear, Auditor/Verifier, Judge)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# Financial Data Providers (Optional Free Tier APIs)
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# SEC EDGAR Compliance (Required by sec.gov to avoid HTTP 403)
SEC_USER_AGENT=IPOMicroCapScouter/1.0 (personal-research@example.com)

# Firebase Firestore (Optional - falls back to local JSON store if omitted)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# Telegram Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SCORE_THRESHOLD=75

# Screening & Portfolio Discipline Parameters
IPO_MIN_MONTHS=6
IPO_MAX_MONTHS=24
MIN_POST_IPO_DRAWDOWN_PCT=15.0
MAX_POST_IPO_DRAWDOWN_PCT=88.0
MIN_RUNWAY_MONTHS=12.0
MIN_REV_GROWTH_YOY=0.0
MONTHLY_MICRO_ORDER_LIMIT=10
DEFAULT_MICRO_ORDER_EUR=35.0
